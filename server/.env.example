# Copy to .env for local runs. On Render, set these in the dashboard instead.

PORT=3000
# The address people will actually visit. Render sets RENDER_EXTERNAL_URL for you.
PUBLIC_URL=

# Shared secret the ElevenLabs agent must send as x-dayone-secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TOOL_SECRET=

# Where published sites are stored.
DATA_DIR=./server/data

# --- Link delivery -------------------------------------------------------
# log | vobiz | twilio.  'log' records the message without sending it.
SMS_PROVIDER=log
SMS_FROM=DayOne

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_BASE_URL=https://api.vobiz.ai
VOBIZ_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Voice ---------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_BROWSER_AGENT_ID=
# Long random signing secret for browser tool tickets. Blueprint generates it.
SESSION_SECRET=

# --- Optional copy polish ------------------------------------------------
# Any OpenAI-compatible endpoint. Leave empty and the generator writes the
# copy itself; the site is complete either way.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
